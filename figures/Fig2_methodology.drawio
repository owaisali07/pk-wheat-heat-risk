<mxfile host="drawio"><diagram id="p8" name="Methodology"><mxGraphModel dx="1120" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="720" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="10" y="40" width="250" height="590" as="geometry"/></mxCell><mxCell id="c3" value="INPUT DATA" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="48" width="250" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="290" y="40" width="270" height="590" as="geometry"/></mxCell><mxCell id="c5" value="RISK COMPONENTS (A–C)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="290" y="48" width="270" height="30" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="590" y="40" width="200" height="590" as="geometry"/></mxCell><mxCell id="c7" value="INTEGRATION (D)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="48" width="200" height="30" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="820" y="40" width="290" height="590" as="geometry"/></mxCell><mxCell id="c9" value="OUTPUTS (E–H)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="820" y="48" width="290" height="30" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Climate and Earth&lt;br&gt;observation&lt;/b&gt;&lt;br&gt;ERA5-Land: T&lt;sub&gt;max&lt;/sub&gt;, T&lt;sub&gt;min&lt;/sub&gt;,&lt;br&gt;dew point, soil moisture&lt;br&gt;CHIRPS rainfall · MODIS&lt;br&gt;NEX-GDDP-CMIP6 (31 GCMs)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="22" y="90" width="226" height="160" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Crop statistics&lt;/b&gt;&lt;br&gt;District wheat area,&lt;br&gt;production and yield,&lt;br&gt;1982–2025 (PBS, CRS,&lt;br&gt;BoS, MNFSR) · SPAM2010" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="22" y="270" width="226" height="160" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Socioeconomic data&lt;/b&gt;&lt;br&gt;MPI 2014–15&lt;br&gt;Agricultural Census 2024&lt;br&gt;Population Census 2023&lt;br&gt;RWI · VIIRS · travel time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="22" y="450" width="226" height="160" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;A. Hazard model&lt;/b&gt;&lt;br&gt;Detrended yield anomalies&lt;br&gt;Stage-wise heat degree-days,&lt;br&gt;VPD, rain, soil moisture&lt;br&gt;XGBoost / RF, blocked CV&lt;br&gt;SHAP/ALE thresholds;&lt;br&gt;heat loss → H&lt;sub&gt;d&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="302" y="90" width="246" height="160" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;B. Exposure&lt;/b&gt;&lt;br&gt;Wheat share of&lt;br&gt;cultivated land&lt;br&gt;Rural wheat-dependent&lt;br&gt;households → E&lt;sub&gt;d&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="302" y="270" width="246" height="160" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;C. Vulnerability index&lt;/b&gt;&lt;br&gt;Poverty, farm size,&lt;br&gt;rainfed share, tenancy,&lt;br&gt;literacy, access&lt;br&gt;PCA weights; checked&lt;br&gt;against RWI → V&lt;sub&gt;d&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="302" y="450" width="246" height="160" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;E. Hotspots and inequality&lt;/b&gt;&lt;br&gt;Local Moran's I (FDR)&lt;br&gt;Concentration curves&lt;br&gt;and index&lt;br&gt;Losses borne by poorest 20%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="832" y="90.0" width="266" height="122.5" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;F. Decision support&lt;/b&gt;&lt;br&gt;District SHAP drivers&lt;br&gt;→ policy lever: varieties,&lt;br&gt;irrigation, insurance,&lt;br&gt;social protection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="832" y="222.5" width="266" height="122.5" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;G. Validation&lt;/b&gt;&lt;br&gt;2021–22 season withheld&lt;br&gt;Predicted vs observed anomalies&lt;br&gt;Risk terciles, cluster vs losses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="832" y="355.0" width="266" height="122.5" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;H. Crop-model projections&lt;/b&gt;&lt;br&gt;WOFOST + APSIM-Wheat, 6 districts&lt;br&gt;CO&lt;sub&gt;2&lt;/sub&gt;, phenology,&lt;br&gt;sowing date, cultivar → RQ4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="832" y="487.5" width="266" height="122.5" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;D. Livelihood risk&lt;/b&gt;&lt;br&gt;&lt;br&gt;R&lt;sub&gt;d&lt;/sub&gt; = H&lt;sub&gt;d&lt;/sub&gt; × E&lt;sub&gt;d&lt;/sub&gt; × V&lt;sub&gt;d&lt;/sub&gt;&lt;br&gt;(scaled to the present-&lt;br&gt;climate range)&lt;br&gt;&lt;br&gt;Monte Carlo,&lt;br&gt;10,000 draws over&lt;br&gt;weights, hazard and&lt;br&gt;climate models&lt;br&gt;&lt;br&gt;Median risk and&lt;br&gt;90% rank interval&lt;br&gt;&lt;br&gt;Present climate;&lt;br&gt;GWL 1.5, 2 and 3 °C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=3;fontFamily=Times New Roman;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="602" y="90" width="176" height="520" as="geometry"/></mxCell><mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.