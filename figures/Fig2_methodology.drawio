lEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.8822;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Cross-cutting:&lt;/b&gt; open data with logged provenance · blocked cross-validation (year, region, forward-chaining) · Monte Carlo uncertainty · 31-model CMIP6 ensemble · CO&lt;sub&gt;2&lt;/sub&gt; fertilisation and adaptation: statistical model excludes them, crop model (H) simulates them at six districts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=15;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="10" y="650" width="1100" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>